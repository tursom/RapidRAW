{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RapidRAW Intake Spike",
  "version": "0.1.0",
  "identifier": "io.github.tursom.rapidraw.intake-spike",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RapidRAW Intake Spike",
        "width": 1050,
        "height": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../src-tauri/icons/32x32.png", "../../../src-tauri/icons/icon.ico"]
  }
}
